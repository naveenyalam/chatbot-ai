      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(nova_agent_timeout_total[1m])) by (agent_type)",
          "legendFormat": "Timeout: {{agent_type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nova_agent_limit_exceeded_total[1m])) by (agent_type)",
          "legendFormat": "Limit Exceeded: {{agent_type}}",
          "refId": "B"
        }

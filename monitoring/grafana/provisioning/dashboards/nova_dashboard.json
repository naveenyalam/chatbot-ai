    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "id": 17,
      "title": "Active SSE Streams & Concurrent Requests",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "nova_active_sse_streams",
          "legendFormat": "Active SSE Streams",
          "refId": "A"
        },
        {
          "expr": "nova_active_http_requests",
          "legendFormat": "Concurrent Requests",
          "refId": "B"
        }
      ]

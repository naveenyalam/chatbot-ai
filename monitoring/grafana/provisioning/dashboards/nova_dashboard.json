        {
          "expr": "sum(rate(nova_llm_retry_total[1m])) by (provider, model)",
          "legendFormat": "Retry: {{provider}} {{model}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nova_llm_timeout_total[1m])) by (provider, model)",
          "legendFormat": "Timeout: {{provider}} {{model}}",
          "refId": "B"
        }
